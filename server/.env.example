# پورت اجرای سرویس بک‌اند (پشت nginx در مسیر /api و /ws)
PORT=4000

# کلید امضای JWT — حتماً در سرور واقعی با یک رشته تصادفی طولانی جایگزین شود
JWT_SECRET=change-this-to-a-long-random-secret

# آدرس(های) مجاز برای CORS (دامنه سایت)
CORS_ORIGIN=https://locationsari.ir,https://www.locationsari.ir

# ---------- درگاه پرداخت ----------
# mock: حالت آزمایشی بدون درگاه واقعی (پیش‌فرض فعلی)
# zarinpal: درگاه زرین‌پال (پس از دریافت مرچنت کد فعال می‌شود)
PAYMENT_PROVIDER=mock

# اطلاعات درگاه زرین‌پال (وقتی PAYMENT_PROVIDER=zarinpal تنظیم شود لازم است)
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=https://locationsari.ir/api/payment/zarinpal/callback
