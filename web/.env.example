DATABASE_URL=postgres://locationsari_app:PASSWORD@127.0.0.1:5432/locationsari
JWT_SECRET=
UPLOAD_DIR=/var/lib/locationsari/uploads

# فاز ۱.۲ — SMS.ir (ارسال کد OTP با Pattern). بدون این کلید، سرویس پیامک غیرفعال است
# و مسیر /api/auth/otp/send خطای 503 برمی‌گرداند (به‌جای شکست کامل build/runtime).
SMSIR_API_KEY=
# اختیاری — پیش‌فرض: 350003
SMSIR_OTP_TEMPLATE_ID=350003
# اختیاری — نام پارامتر داخل قالب پنل SMS.ir (پیش‌فرض: otp)
SMSIR_OTP_PARAM_NAME=otp

# کلید «وب‌سرویس» نقشهٔ نشان (با پیشوند service.) — برای جستجوی آدرس/موقعیت دقیق در ثبت آگهی
# و «تماس با ما»، و تولید نقشهٔ استاتیک. بدون این کلید، مسیرهای /api/geo/* خطای 503 برمی‌گردانند.
NESHAN_API_KEY=
